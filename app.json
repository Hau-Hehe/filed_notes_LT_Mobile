{
  "expo": {
    "name": "Field Notes",
    "slug": "1923050645_1923050808_field_notes",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fieldnotes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dntu.fieldnotes"
    },
    "android": {
      "package": "com.dntu.fieldnotes",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Field Notes to access your GPS location for field tagging."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Field Notes to access your photos for attaching field evidence."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
